    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#LongDuration -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#LongDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
    </owl:Class>
    


