    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeDivisionOfLabor -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeDivisionOfLabor">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Communication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability"/>
        <rdfs:comment>A complex social capability discovered in the literature review on imprecise fuzzy techniques in social robotics conducted by the Chair of Digital Manufacturing at the University of Augsburg (https://github.com/Neroware/CPSL2026-Reproduce-SLR). 
These classes are essentially a subset of a top layer in a taxonomy tree on social robot capability.</rdfs:comment>
        <rdfs:label>Complex Social Capability</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A concrete social capability is part of some form of complex social capability and represents a certain aspect of said capability. 
E.g.: A robot&apos;s capability to adjust the speaking style depending on the role of the person it communicates with is a concrete social capability and a part of the complex social capability of Social-Cognitive Communication.</rdfs:comment>
        <rdfs:label>Concrete Social Capability</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Days -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Days">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#preconditions"/>
                <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Desire -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A device primitive is a low-level, hardware-related action that directly controls a device (robot arm, gripper, sensor) and has no semantic significance at the task level. A skill can be constituted of multiple primitives.
E.g.: A robot&apos;s Pick-and-Place skill has the two device primitives for Opening and Closing the gripper as constituents.</rdfs:comment>
        <rdfs:label>Device Primitive</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalBelief -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalBelief">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalDesire -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalDesire">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire"/>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DrivingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DrivingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Education -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Education">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalAdaptability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Entertainment -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Entertainment">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseLevelScale -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseLevelScale">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#QualitativeAmount"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Experts -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Experts">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ReceiveCapabilitiy"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SendCapability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FixedPatterns -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FixedPatterns">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Limited adjustments; mostly follows fixed interaction patterns</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FlyingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FlyingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyAdaptive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyAdaptive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Responds to user preferences and situational changes with some flexibility</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProactivityLevel"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyReactive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyReactive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProactivityLevel"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyStatic -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyStatic">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Fully static behavior; no adjustment to user or context</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HighlyAdaptive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HighlyAdaptive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Continuously adjusts behavior based on user cues, context, and history</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Hours -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Hours">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanEmotionRecognition -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanEmotionRecognition">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanIntentionRecognition -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanIntentionRecognition">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanPartner -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanPartner">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanProperty -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanProperty">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Human"/>
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#NaturalPerson"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentProperty"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanToSocialRobot -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanToSocialRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RatioRegion"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Humanoid -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Humanoid">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#IndustrialRobot -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#IndustrialRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotType"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Industry -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Industry">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InformationExchangeTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InformationExchangeTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Intention -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Intention">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Plan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasSpecifiedOutput"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger"/>
                <owl:allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ProductionAction"/>
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#QuantitativeAmount"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionDuration -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
        <rdfs:comment>Represents the duration of any interaction as a fixed time interval. Example: The interaction between me and the robot took exactly 5 minutes, until we reached our collaborative goal.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionTimeFrame -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionTimeFrame">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame"/>
        <rdfs:comment>The time frame a single or multiple interactions can occur in. Example: During my stay at the hospital over the recent two weeks, a service robot brought me my food twice each day.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionsPerDay -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionsPerDay">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#FrequencyRegion"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RatioRegion"/>
        <rdfs:comment>The amount of ocurred social interactions per day</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#IntimateProxemicZone -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#IntimateProxemicZone">
