<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.forsocialrobots.de/ontologies/sobots.owl#"
     xml:base="https://www.forsocialrobots.de/ontologies/sobots.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:DUL="http://www.loa-cnr.it/ontologies/DUL.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:sobot="https://www.forsocialrobots.de/ontologies/sobots.owl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl">
        <owl:imports rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho/1.0.0"/>
        <owl:imports rdf:resource="http://purl.oclc.org/NET/ssnx/ssn"/>
        <owl:imports rdf:resource="http://www.iri.upc.edu/groups/perception/OCRA/ont/ocra.owl"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasSkill -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasSkill">
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Agent"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasSpecifiedOutput -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasSpecifiedOutput">
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf"/>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
        <rdfs:comment>A relation linking a disposition to its set of triggers causing a realization of said disposition.</rdfs:comment>
        <rdfs:label>has trigger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#involvesCompetenceIn -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#involvesCompetenceIn">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn"/>
        <rdfs:domain rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:range rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isRealizationOf -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isRealizationOf">
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:comment>A relation linking a realization to its corresponding disposition.</rdfs:comment>
        <rdfs:label>is realization of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf"/>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf"/>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:label>A relation linking a trigger to a dispositon, which is realized if the trigger occurs.</rdfs:label>
        <rdfs:label>is trigger of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#postconditionedBy -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#postconditionedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#postconditions"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:comment>Indicates that an event or situation occurs as a cause of another event. This relation identifies the event whose execution is the consequence of the current event or situation. For example, heavy rainfall may have flooded fields as its postcondition.</rdfs:comment>
        <rdfs:label>postconditioned by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#postconditions -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#postconditions">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates an event to another event or situation. This linked postcondition describes an event that follows as a consequence of a previous state or event. For example, heavy rainfall may have flooded fields as its postcondition.</rdfs:comment>
        <rdfs:label>postconditions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#preconditionedBy -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#preconditionedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <owl:inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#preconditions"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:comment>Indicates that an event or situation must follow another event. This relation identifies the prior event required for the current situation to hold or event to occur. For example, boiling water may be preconditioned by heating the pot on a stove.</rdfs:comment>
        <rdfs:label>preconditioned by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#preconditions -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#preconditions">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates an event to another event or situation. This linked precondition specifies necessary enabling events that must occur before a situation holds or another event occurs. For example, cooking may have boiling water as one of its preconditions.</rdfs:comment>
        <rdfs:label>preconditions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn -->

    <owl:ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn">
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
        <rdfs:comment>A relation linking a disposition to its set of realizations that occur after the disposition&apos;s trigger(s) hold true.</rdfs:comment>
        <rdfs:label>realized in</rdfs:label>
    </owl:ObjectProperty>
    


