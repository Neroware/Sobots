    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MotivationalAdaptability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MotivationalAdaptability">
