    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel">
