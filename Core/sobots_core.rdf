    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Skill -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Description"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                <someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Method"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A skill describes an agent&apos;s capability by implementing a Method.
E.g.: A robot can have the capability to move objects, described by a skill &quot;Pick-and-Place&quot;, which implements the Function &quot;PickPlace&quot;.</rdfs:comment>
        <rdfs:label>Skill</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SmellDiscernment -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SmellDiscernment">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can identify particular airborne gases and smells.</rdfs:comment>
        <rdfs:label>Smell Discernment</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAwareness -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAwareness">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom>
                    <Class>
                        <intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EyeTracking"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FaceRecognition"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#GestureRecognition"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanEmotionRecognition"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ObjectRecognition"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#PoseTracking"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechRecognition"/>
                        </intersectionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom>
                    <Class>
                        <intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#KnowledgeCapability"/>
                            <Class>
                                <unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EyeTracking"/>
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FaceRecognition"/>
                                </unionOf>
                            </Class>
                        </intersectionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The knowledge of how to change one&apos;s self-presentation based on social context factors</rdfs:comment>
        <rdfs:label>Social Awareness</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialComprehension -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialComprehension">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#KnowledgeCapability"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCuesGeneration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCuesGeneration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can generate sounds that are not part of a human language.</rdfs:comment>
        <rdfs:label>Sound Cues Generation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialDistance -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialDistance">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialFunction -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialFunction">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
                    <Restriction>
                        <onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                        <allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Method"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialPlan -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialPlan">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Plan"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <allValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
                <allValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SocialGoal"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialProxemicZone -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialProxemicZone">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProxemicZone"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AutonomousRobot"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialAgent"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#hasCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#hasEmbodiment"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotInterface"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasQuality"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotAutonomy"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isRegionFor"/>
                <allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotContext">
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent"/>
                <minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minQualifiedCardinality>
                <onClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SoftwareCapability"/>
        <rdfs:comment>An abstract social capability as defined by Mahdi et al.: A survey on the design and evolution of social robots — Past, present and future, 2022 (Table 4).
These classes are essentially a subset of a top layer in a taxonomy tree on social robot capability.</rdfs:comment>
        <rdfs:comment>This class describes software features of each system given the feature’s purpose is rooted in social interaction. It is important to note that many robots have more general software capabilities to support their mechatronic systems but have been left out as they are not social in nature; ex: proprioceptive sensing. In a separate column, sensors used to achieve the social interaction capabilities are listed.</rdfs:comment>
        <rdfs:label>Social Robot Feature</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotProperty -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotProperty">
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotProperty"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A social skill describes some form of social capability.</rdfs:comment>
        <rdfs:label>Social Skill</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocioCulturalAdaptability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocioCulturalAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SoftwareCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SoftwareCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:comment>Represents the ability of a robot to perform functions that are enabled through software components, algorithms, or computational processes rather than physical hardware. It encompasses capabilities that arise from software modules running on the robot’s computing infrastructure, such as perception, reasoning, planning, communication, and interaction processing.</rdfs:comment>
        <rdfs:label>Software Capability</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Sound -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Sound">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:label>Sound</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SoundCuesGeneration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SoundCuesGeneration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can generate sounds that are not part of a human language.</rdfs:comment>
        <rdfs:label>Sound Cues Generation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechLocalization -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechLocalization">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can direct its attention to a location in space where a source of speech is perceived.</rdfs:comment>
        <rdfs:label>Speech Localization</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechRecognition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechRecognition">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot is able to understand user speech.</rdfs:comment>
        <rdfs:label>Speech Recognition</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechSynthesis -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechSynthesis">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot can generate speech.</rdfs:comment>
        <rdfs:label>Speech Synthesis</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Stationary -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Stationary">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SuperficialAdaptations -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SuperficialAdaptations">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Rare or superficial adaptation (e.g., simple parameter changes)</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SwimmingCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SwimmingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Tactile -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Tactile">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot reacts to user touch on its build, which does not include a touchscreen.</rdfs:comment>
        <rdfs:label>Tactile</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TechnicalSystem -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TechnicalSystem">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Teleoperation -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Teleoperation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>Can be controlled in real-time by a human operator.</rdfs:comment>
        <rdfs:label>Teleoperation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
        <rdfs:comment>Represents the duration of any event as a fixed time interval. Example: It took me 8 years to graduate from grammar school.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
        <rdfs:comment>A time frame one or multiple events can occur in. Example: During the recent three years this person visited me twice.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Touching -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Touching">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Touchscreen -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Touchscreen">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Screen"/>
        <rdfs:comment>The robot reacts to user input from a touchscreen.</rdfs:comment>
        <rdfs:label>Touchscreen</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TransportTaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TransportTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger">
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCommunication -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCommunication">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction"/>
                </unionOf>
            </Class>
        </rdfs:subClassOf>
        <disjointWith>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCommunication"/>
                </unionOf>
            </Class>
        </disjointWith>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#VisualHint -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VisualHint">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#WalkingCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#WalkingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </Class>
    


