<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:DUL="http://www.loa-cnr.it/ontologies/DUL.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:sobot="https://www.forsocialrobots.de/ontologies/sobots.owl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <Ontology rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl">
        <imports rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho/1.0.0"/>
        <imports rdf:resource="http://purl.oclc.org/NET/ssnx/ssn"/>
        <imports rdf:resource="http://www.iri.upc.edu/groups/perception/OCRA/ont/ocra.owl"/>
    </Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasPostconditionEvent -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasPostconditionEvent">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isPostconditionEventOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:comment>Indicates that an event or situation occurs as a cause of another event. This relation identifies the event whose execution is the consequence of the current event or situation. For example, heavy rainfall may have flooded fields as its postcondition.</rdfs:comment>
        <rdfs:label>postconditioned by</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasPreconditionEvent -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasPreconditionEvent">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isPreconditionEventOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:comment>Indicates that an event or situation must follow another event. This relation identifies the prior event required for the current situation to hold or event to occur. For example, boiling water may have the precondition of heating the pot on a stove.</rdfs:comment>
        <rdfs:label>preconditioned by</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasSkill -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasSkill">
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Agent"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasSpecifiedOutput -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasSpecifiedOutput">
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf"/>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
        <rdfs:comment>A relation linking a disposition to its set of triggers causing a realization of said disposition.</rdfs:comment>
        <rdfs:label>has trigger</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#involvesCompetenceIn -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#involvesCompetenceIn">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn"/>
        <rdfs:domain rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isInvolvedCompetenceIn">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:range rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isPostconditionEventOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isPostconditionEventOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:range>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </unionOf>
            </Class>
        </rdfs:range>
        <rdfs:comment>Relates an event to another event or situation. This linked postcondition describes an event that follows as a consequence of a previous state or event. For example, heavy rainfall may have flooded fields as its postcondition.</rdfs:comment>
        <rdfs:label>isPostconditionEventOf</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isPreconditionEventOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isPreconditionEventOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <rdfs:domain rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:range>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
                </unionOf>
            </Class>
        </rdfs:range>
        <rdfs:comment>Relates an event to another event or situation. This linked precondition specifies necessary enabling events that must occur before a situation holds or another event occurs. For example, cooking may have boiling water as a precondition.</rdfs:comment>
        <rdfs:label>isPreconditionEventOf</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isRealizationOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isRealizationOf">
        <inverseOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:comment>A relation linking a realization to its corresponding disposition.</rdfs:comment>
        <rdfs:label>is realization of</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isSkillOf"/>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf"/>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes"/>
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:label>A relation linking a trigger to a dispositon, which is realized if the trigger occurs.</rdfs:label>
        <rdfs:label>is trigger of</rdfs:label>
    </ObjectProperty>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn -->

    <ObjectProperty rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn">
        <rdfs:domain rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:range rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
        <rdfs:comment>A relation linking a disposition to its set of realizations that occur after the disposition&apos;s trigger(s) hold true.</rdfs:comment>
        <rdfs:label>realized in</rdfs:label>
    </ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#AutonomyLevel -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#AutonomyLevel">
        <equivalentClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomyLevel"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#ComplexTask -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ComplexTask">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#ExpertiseLevelScale -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ExpertiseLevelScale">
        <equivalentClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseLevelScale"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#Function -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#HumanAction -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#HumanAction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#HumanFunction -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#HumanFunction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#JointAction -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#JointAction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#ObjectDetection -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ObjectDetection">
        <equivalentClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ObjectRecognition"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#ProductionPlan -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ProductionPlan">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialPlan"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotAction -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotAction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotFunction -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotFunction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
    </rdf:Description>
    


    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleTask -->

    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleTask">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
    </rdf:Description>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Amount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgeGroup -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeGroup">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgeInYears -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeInYears">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeRegion"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgeRegion -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeRegion">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#QuantitativeAmount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAppearance -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAppearance">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentEmbodimentProperty"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAutonomy -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAutonomy">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AgentProactivity -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentProactivity">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Agreeableness -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Agreeableness">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionExpression"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Android -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Android">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalLikeness -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalLikeness">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalPartner -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalPartner">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Art -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Art">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AuditiveHint -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AuditiveHint">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomousNavigation -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomousNavigation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>Navigate in space, avoiding collision with objects and humans, possibly accounting for proxemics.</rdfs:comment>
        <rdfs:label>Autonomous Navigation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomyLevel -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomyLevel">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Amount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Belief -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#BeliefBaseInterface -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#BeliefBaseInterface">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#KnowledgeCapability"/>
        <rdfs:comment>The capability of storing beliefs and providing an interface to add, update and remove them.</rdfs:comment>
        <rdfs:label>Belief Base Interface</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#BodyMovement -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#BodyMovement">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot uses actuators to assist in communication (ex: move arm for on-spot mobile robots, or move in space for mobile robots).</rdfs:comment>
        <rdfs:label>Body movement</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Children -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Children">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeGroup"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Close -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Close">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveAdaptability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveTaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAwareness"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom>
                    <Class>
                        <unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Gesture"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Screen"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SpeechSynthesis"/>
                        </unionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requires"/>
                <minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minQualifiedCardinality>
                <onClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <disjointWith rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Communication"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CompliantActuation -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CompliantActuation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The system responds to external perturbations/forces by deviating from the target position to ensure safe operation.</rdfs:comment>
        <rdfs:label>Compliant Actuation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ConflictManagement -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ConflictManagement">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#NegotiationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAwareness"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Days -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Days">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isPreconditionEventOf"/>
                <someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Desire -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                <someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A device primitive is a low-level, hardware-related action that directly controls a device (robot arm, gripper, sensor) and has no semantic significance at the task level. A skill can be constituted of multiple primitives.
E.g.: A robot&apos;s Pick-and-Place skill has the two device primitives for Opening and Closing the gripper as constituents.</rdfs:comment>
        <rdfs:label>Device Primitive</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition">
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger"/>
                <someValuesFrom>
                    <Class>
                        <intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
                        </intersectionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </equivalentClass>
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                <someValuesFrom>
                    <Class>
                        <intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
                        </intersectionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalBelief -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalBelief">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
                    <Restriction>
                        <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                        <allValuesFrom>
                            <Class>
                                <intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
                                </intersectionOf>
                            </Class>
                        </allValuesFrom>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalDesire -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalDesire">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
                    <Restriction>
                        <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                        <allValuesFrom>
                            <Class>
                                <intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire"/>
                                </intersectionOf>
                            </Class>
                        </allValuesFrom>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DrivingCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DrivingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Education -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Education">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionExpression -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionExpression">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalAdaptability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalTaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EmotionalTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Entertainment -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Entertainment">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExchangeTactics -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExchangeTactics">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialComprehension"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseLevelScale -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseLevelScale">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#QualitativeAmount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Experts -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Experts">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCommunication -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCommunication">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction"/>
                </unionOf>
            </Class>
        </rdfs:subClassOf>
        <disjointWith>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCommunication"/>
                </unionOf>
            </Class>
        </disjointWith>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EyeMovement -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EyeMovement">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot can move its eyes to assist in communication.</rdfs:comment>
        <rdfs:label>Eye Movement</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#EyeTracking -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#EyeTracking">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot re-orientates to follow user gaze.</rdfs:comment>
        <rdfs:label>Eye Tracking</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FaceRecognition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FaceRecognition">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can follow and locate human faces.</rdfs:comment>
        <rdfs:label>Face Recognition</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FacialExpression -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FacialExpression">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot can actuate its face in an anthropomorphic way to communicate emotions/information.</rdfs:comment>
        <rdfs:label>Facial Expression</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FixedPatterns -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FixedPatterns">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Limited adjustments; mostly follows fixed interaction patterns</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FlyingCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FlyingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyAdaptive -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyAdaptive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Responds to user preferences and situational changes with some flexibility</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProactivityLevel"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyReactive -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyReactive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProactivityLevel"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyStatic -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyStatic">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Fully static behavior; no adjustment to user or context</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Gesture -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Gesture">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot generates gestures for the user to view.</rdfs:comment>
        <rdfs:label>Gesture</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#GestureRecognition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#GestureRecognition">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can understand gestural cues, typically using vision.</rdfs:comment>
        <rdfs:label>Gesture Recognition</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HeadMovement -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HeadMovement">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot can move its head to assist in communication.</rdfs:comment>
        <rdfs:label>Head Movement</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HighlyAdaptive -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HighlyAdaptive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Continuously adjusts behavior based on user cues, context, and history</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Hours -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Hours">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanEmotionRecognition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanEmotionRecognition">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The system can identify various anthropomorphic emotions.</rdfs:comment>
        <rdfs:label>Human Emotion Recognition</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanPartner -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanPartner">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanProperty -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanProperty">
        <equivalentClass>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <someValuesFrom>
                    <Class>
                        <unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Human"/>
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#NaturalPerson"/>
                        </unionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentProperty"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#HumanToSocialRobot -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanToSocialRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RatioRegion"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Humanoid -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Humanoid">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ImpressionManagementTactics -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ImpressionManagementTactics">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#IndustrialRobot -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#IndustrialRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotType"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Industry -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Industry">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InformationExchangeTaskContext -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InformationExchangeTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Intention -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Intention">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Plan"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isSpecifiedOutputOf"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger"/>
                <allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                <allValuesFrom>
                    <Class>
                        <unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#ProductionAction"/>
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
                        </unionOf>
                    </Class>
                </allValuesFrom>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#QuantitativeAmount"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionDuration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
        <rdfs:comment>Represents the duration of any interaction as a fixed time interval. Example: The interaction between me and the robot took exactly 5 minutes, until we reached our collaborative goal.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:comment>An abstract communication capability as defined by Mahdi et al.: A survey on the design and evolution of social robots — Past, present and future, 2022 (Table 4).
These classes are essentially a subset of a top layer in a taxonomy tree on social robot capability.</rdfs:comment>
        <rdfs:comment>These terms outline how the robot can interact with users from the user’s perspective.</rdfs:comment>
        <rdfs:label>Interaction Modality</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionTimeFrame -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionTimeFrame">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame"/>
        <rdfs:comment>The time frame a single or multiple interactions can occur in. Example: During my stay at the hospital over the recent two weeks, a service robot brought me my food twice each day.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionsPerDay -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionsPerDay">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#FrequencyRegion"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RatioRegion"/>
        <rdfs:comment>The amount of ocurred social interactions per day</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#IntimateProxemicZone -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#IntimateProxemicZone">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProxemicZone"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Intracorporeal -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Intracorporeal">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#KnowledgeCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#KnowledgeCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SoftwareCapability"/>
        <rdfs:comment>Represents the ability to acquire, represent, manage, and use knowledge about its environment, tasks, users, or internal state.</rdfs:comment>
        <rdfs:label>Knowledge Capability</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Laymen -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Laymen">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ExpertiseGroup"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#LearningCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#LearningCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>Uses learning algorithms applied to environmental and user data to adapt the robot’s behavior to offer better interaction over time.</rdfs:comment>
        <rdfs:label>Learning abilities</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Lights -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Lights">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionModality"/>
        <rdfs:comment>The robot employs non-screen lights (ex: LEDs).</rdfs:comment>
        <rdfs:label>Lights</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#LongDuration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#LongDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame"/>
        <rdfs:comment>An interaction time frame between years and open ended.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MedicalRobot -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MedicalRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotType"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MediumTerm -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MediumTerm">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame"/>
        <rdfs:comment>An interaction time frame between weeks and months.</rdfs:comment>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Minutes -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Minutes">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Mobile -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Mobile">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Amount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ModerateDuration -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ModerateDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Months -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Months">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MediumTerm"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#MotivationalAdaptability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#MotivationalAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NaturalRobot -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NaturalRobot">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAgent"/>
        <rdfs:comment>&quot;A robot is a reprogrammable, multifunctional manipulator designed to move material, parts, tools or specialized devices through variable programmed motions for the performance of a variety of tasks&quot; -Robotic Industries Association</rdfs:comment>
        <rdfs:label>Natural robot</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NegotiationCapability -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NegotiationCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresCapability"/>
                <someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialComprehension"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NoResemblance -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NoResemblance">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalLikeness"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCommunication -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCommunication">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction"/>
                </unionOf>
            </Class>
        </rdfs:subClassOf>
        <disjointWith>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCommunication"/>
                </unionOf>
            </Class>
        </disjointWith>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Notify -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SendExtraverbal"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OZTeleoperation -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OZTeleoperation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Teleoperation"/>
        <rdfs:comment>Real-time remote control that appears to be autonomous. Usually used for research purposes.</rdfs:comment>
        <rdfs:label>Wizard Of Oz Teleoperation</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ObjectRecognition -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ObjectRecognition">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SensingCapability"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotFeature"/>
        <rdfs:comment>The robot can identify and localize objects.</rdfs:comment>
        <rdfs:label>Object Recognition</rdfs:label>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccasionalInteraction -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccasionalInteraction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief"/>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Goal"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCommunication -->

    <Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCommunication">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationPerception"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProduction"/>
                </unionOf>
            </Class>
        </rdfs:subClassOf>
        <disjointWith>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ExtraverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCommunication"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCommunication"/>
                </unionOf>
            </Class>
        </disjointWith>
