                                <onProperty rdf:resource="http://www.iri.upc.edu/groups/perception/OCRA/ont/ocra.owl#executesPlan"/>
                                <allValuesFrom>
                                    <Class>
                                        <intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Plan"/>
                                            <Restriction>
                                                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
                                                <someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Goal"/>
                                            </Restriction>
                                            <Restriction>
                                                <onProperty rdf:resource="http://www.iri.upc.edu/groups/perception/OCRA/ont/ocra.owl#isWorsePlanThan"/>
