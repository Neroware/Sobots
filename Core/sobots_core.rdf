            <Restriction>
                <onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <someValuesFrom>
                    <Class>
                        <unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#AutonomousRobot"/>
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Cobot"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NaturalRobot"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
                        </unionOf>
                    </Class>
                </someValuesFrom>
            </Restriction>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentProperty"/>
    </Class>
    


